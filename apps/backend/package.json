    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "groq-sdk": "^1.5.0",
    "helmet": "^7.1.0",
    "livekit-server-sdk": "^2.6.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "resend": "^4.0.0",
    "socket.io": "^4.7.5",
    "stripe": "^16.8.0",
