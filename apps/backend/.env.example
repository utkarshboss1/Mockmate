# ─── Database ────────────────────────────────────────────────
# Local dev: docker compose up -d, then use the line below.
# Supabase / Neon / Railway: replace with the provider's IPv4-friendly URL.
DATABASE_URL="postgresql://mockmate:mockmate@localhost:5432/mockmate?schema=public"
DIRECT_URL="postgresql://mockmate:mockmate@localhost:5432/mockmate?schema=public"

# ─── App ──────────────────────────────────────────────────────
NODE_ENV="development"
PORT=4000
FRONTEND_URL="http://localhost:3000"

# ─── Storage Mode ────────────────────────────────────────────
# - "memory"   : in-process Maps for users/bookings (no DB needed).
#                Used on college IPv4 LAN while Supabase IPv4 is paid.
# - "database" : every read/write goes through Prisma. Requires DATABASE_URL
#                to be reachable at boot.
STORAGE_MODE="memory"

# ─── Better Auth ─────────────────────────────────────────────
BETTER_AUTH_SECRET="dev-secret-please-replace-in-production-min-32-chars"
BETTER_AUTH_URL="http://localhost:4000"

# ─── LiveKit ──────────────────────────────────────────────────
LIVEKIT_API_KEY="devkey"
LIVEKIT_API_SECRET="secret"
LIVEKIT_URL="wss://demo.livekit.cloud"

# ─── Cloudinary ───────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME="demo"
CLOUDINARY_API_KEY="123456789"
CLOUDINARY_API_SECRET="abcdefghijklmnopqrstuvwxyz"

# ─── Resend ───────────────────────────────────────────────────
RESEND_API_KEY="re_123456789_mock_key"
EMAIL_FROM="MockMate <noreply@mockmate.in>"

# ─── AI (Groq is the only currently-implemented provider) ────
GROQ_API_KEY=""

# ─── Razorpay (test mode) ─────────────────────────────────────
RAZORPAY_KEY_ID="rzp_test_mock_key"
RAZORPAY_KEY_SECRET="mock_secret"
RAZORPAY_WEBHOOK_SECRET="mock_webhook_secret"

# ─── Redis (used for Socket.IO adapter + rate-limit store) ───
# Optional in dev — leave empty to fall back to in-memory adapter.
REDIS_URL=""

# ─── Dev Controls (never set to "true" in production) ────────
ALLOW_MOCK_AUTH="true"
